<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ai.storyteller.craft-anything</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Craft Anything</name>
  <summary>Find out how any software works, then craft your own</summary>
  <developer id="ai.storyteller">
    <name>Learning Machines LLC</name>
  </developer>
  <description>
    <p>
      Craft Anything shows anyone how a piece of software works, with answers backed by evidence,
      then helps them rebuild it. Open a program, an app, a file or a website and get a plain
      explanation of what it is, what it does and how it is put together.
    </p>
    <ul>
      <li>Reads executables, libraries, archives, Android packages, WebAssembly and web bundles</li>
      <li>A built-in disassembler with functions, call graphs and pseudo-C</li>
      <li>Every answer carries its evidence, confidence and what is still unknown</li>
      <li>Beginner and Experienced modes</li>
      <li>Every action is a tool, scriptable from a CLI and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">ai.storyteller.craft-anything.desktop</launchable>
  <icon type="stock">ai.storyteller.craft-anything</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://getartcraft.com/apps/craft-anything</url>
  <url type="bugtracker">https://github.com/storytold/craft-anything/issues</url>
  <url type="help">https://github.com/storytold/craft-anything</url>
  <url type="contact">https://discord.gg/artcraft</url>
  <categories>
    <category>Development</category>
    <category>Debugger</category>
  </categories>
  <keywords>
    <keyword>reverse engineering</keyword>
    <keyword>disassembler</keyword>
    <keyword>binary analysis</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#efc39f</color>
    <color type="primary" scheme_preference="dark">#8f4612</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>craft-anything</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
