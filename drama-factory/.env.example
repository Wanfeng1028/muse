# ==============================================================================
# Drama Factory 环境变量示例文件
# ------------------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env（或直接在部署环境中设置同名环境变量）。
#   2. 按需修改下方各项的值。
#   3. Spring Boot 启动时会以这些环境变量覆盖 application.yml 中的同名占位符，
#      例如 application.yml 中写 ${PORT:8080}，则会优先使用环境变量 PORT 的值。
#
# 说明：
#   - Spring Boot 的配置属性占位符支持从环境变量读取，环境变量优先级高于
#     application.yml 中的默认值。
#   - 环境变量名与配置属性名的对应关系为：大写 + 点号替换为下划线。
#     例如配置项 server.port 对应环境变量 SERVER_PORT，
#     本文件中的 PORT 用于覆盖 application.yml 中形如 ${PORT:8080} 的占位符。
# ==============================================================================

# 服务端口：Spring Boot 内嵌 Web 容器监听的端口
PORT=8081

# H2 数据库连接地址（文件库模式）
# 默认使用项目运行目录下的 ./data/drama-factory 作为数据库文件路径，
# 首次启动会自动创建该文件，数据在应用重启后仍然保留。
# 若需要测试用的内存库，可在测试配置中使用：
#   jdbc:h2:mem:drama-factory;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_URL=jdbc:h2:file:./data/drama-factory

# --- v2.2 新增 ---
# JSON 结构化日志：取消下一行注释即切换为 Logstash JSON 输出（含 request_id）
# SPRING_PROFILES_ACTIVE=json

# 视频 Provider：mock（默认，无需外部账号）或 agnes（真实 AI 视频生成，需配代理鉴权）
VIDEO_PROVIDER=mock

# 熔断/限流阈值微调（如需调整，取消注释；环境变量名按 Spring Boot 宽松绑定规则对应 resilience4j 配置）
# RESILIENCE4J_CIRCUITBREAKER_INSTANCES_AGNES_FAILURE_RATE_THRESHOLD=50
# RESILIENCE4J_RATELIMITER_INSTANCES_VIDEOSUBMIT_LIMIT_FOR_PERIOD=10
