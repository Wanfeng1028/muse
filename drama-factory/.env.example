# ==============================================================================
# Drama Factory 环境变量示例文件
# ------------------------------------------------------------------------------
# 使用方法：
#   1. cp .env.example .env
#   2. 填 AUTH_JWT_SECRET（必填，见下）
#   3. docker compose up -d --build
#
# 说明：
#   - Spring Boot 的配置属性占位符支持从环境变量读取，环境变量优先级高于
#     application.yml 中的默认值。
#   - 环境变量名与配置属性名的对应关系为：大写 + 点号替换为下划线。
# ==============================================================================

# ============ 必填：JWT ============
# JWT 签名密钥（auth-service 签发、主服务验签，共用同一密钥）。
# 生成命令：openssl rand -base64 48
# 为空时：auth-service 拒绝启动；主服务 API 为开放模式（仅适合单机本地）。
AUTH_JWT_SECRET=

# ============ OAuth（可选，全空则对应渠道返回 501 OAUTH_NOT_CONFIGURED） ============
# Google：https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub：https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple：https://developer.apple.com/account/resources/authkeys/list
# APPLE_PRIVATE_KEY 为 .p8 文件内容（含 BEGIN/END 行，换行用 \n 转义）
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ============ 主服务 ============
# 服务端口：Spring Boot 内嵌 Web 容器监听的端口
PORT=8081

# H2 数据库连接地址（文件库模式）
# 默认使用项目运行目录下的 ./data/drama-factory 作为数据库文件路径，
# 首次启动会自动创建该文件，数据在应用重启后仍然保留。
DB_URL=jdbc:h2:file:./data/drama-factory

# 视频 Provider：mock（默认，无需外部账号）或 agnes（真实 AI 视频生成，需配代理鉴权）
VIDEO_PROVIDER=mock
