{
  "name": "scrapbook",
  "version": "0.1",
  "extends": "base",
  "description": "拼贴手账：暖白纸底、暖棕墨色、珊瑚橙强调（呼应拍立得相纸边框）、灰蓝辅色（呼应纸胶带）。取自 library/ 的 vlog 演示（拼贴手账风格），是按演示视频的观感重新配的令牌起点，颜色未逐像素取自源素材，用前按自己的素材微调。关键词角色默认换成手写体（kai），贴合日记手账的手写感。",
  "colors": {
    "bg": "#F5EDE0",
    "bg_glow": "#FBF5EA",
    "panel": "#EFE3D0",
    "panel_2": "#FFFBF3",
    "text": "#3A2E22",
    "text_dim": "#8A7860",
    "accent": "#E8875A",
    "accent_hi": "#F5B98A",
    "accent_2": "#6B9080",
    "hair": "#DED0B8",
    "stroke": "#C9B896",
    "highlight_bg": "#E8875A",
    "highlight_text": "#FFFBF3"
  },
  "type": {
    "keyword": { "font": "kai", "weight": 500, "size": 92, "tracking": 1 }
  },
  "post": {
    "bloom": [0.15, 0.1],
    "grain": { "opaque": 1.3, "overlay": 0.15 },
    "vignette": { "opaque": 0.22, "overlay": 0.0 }
  }
}
