# FeedFlow 环境变量示例
# 复制为 .env 后按需修改

# SQLite 数据库文件路径
FEEDFLOW_DB=data/feedflow.db

# 服务监听地址
FEEDFLOW_HOST=127.0.0.1

# 服务监听端口
FEEDFLOW_PORT=8300

# 抓取间隔（单位：分钟）
FEEDFLOW_FETCH_INTERVAL=30

# 抓取请求使用的 User-Agent
FEEDFLOW_USER_AGENT=FeedFlow/0.1

# 每日必读默认篇数
FEEDFLOW_DIGEST_N=20

# 单篇正文提取下载超时（秒），超时回落 RSS 摘要
FEEDFLOW_EXTRACT_TIMEOUT=15

# Fever API 的 api_key（用 `python -m feedflow fever-key` 生成）；为空则关闭 Fever 接口
FEEDFLOW_FEVER_API_KEY=

# HTTP 限流：补充速率（请求/秒，默认 1.0 = 每分钟 60 请求）
FEEDFLOW_RATE_LIMIT_RPS=1.0
# HTTP 限流：令牌桶容量（突发请求数，默认 60）
FEEDFLOW_RATE_LIMIT_BURST=60
# HTTP 限流开关：0/false/no/off 关闭，默认开启
FEEDFLOW_RATE_LIMIT_ENABLED=1

# 可选单用户密码门：默认关闭，不设即不开启
# 推荐用哈希（生成方法见 OPERATIONS.md 第 11 节）；明文版仅启动时当场哈希，不落盘
# FEEDFLOW_AUTH_PASSWORD_HASH=
# FEEDFLOW_AUTH_PASSWORD=
# 开启密码门时必填，否则启动即退出：会话签名密钥，设一串随机长字符串
# FEEDFLOW_SECRET_KEY=
# 登录失败锁定（v1.11.0 起，密码门开启时生效）：窗口内失败次数达阈值即锁定
# FEEDFLOW_AUTH_MAX_ATTEMPTS=5
# FEEDFLOW_AUTH_LOCK_MINUTES=15
# FEEDFLOW_AUTH_WINDOW_MINUTES=15
