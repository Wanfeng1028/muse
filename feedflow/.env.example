# FeedFlow 环境变量示例
# 复制为 .env 后按需修改

# SQLite 数据库文件路径
FEEDFLOW_DB=data/feedflow.db

# 服务监听地址
FEEDFLOW_HOST=127.0.0.1

# 服务监听端口
FEEDFLOW_PORT=8300

# 抓取间隔（单位：分钟）
FEEDFLOW_FETCH_INTERVAL=30

# 抓取请求使用的 User-Agent
FEEDFLOW_USER_AGENT=FeedFlow/0.1

# 每日必读默认篇数
FEEDFLOW_DIGEST_N=20

# 单篇正文提取下载超时（秒），超时回落 RSS 摘要
FEEDFLOW_EXTRACT_TIMEOUT=15

# Fever API 的 api_key（用 `python -m feedflow fever-key` 生成）；为空则关闭 Fever 接口
FEEDFLOW_FEVER_API_KEY=
