# HTTP 监听地址，默认 :8080
LINKSHORT_ADDR=:8080

# SQLite 数据库文件路径，默认 ./data/linkshort.db
LINKSHORT_DB=./data/linkshort.db

# 管理接口密钥；留空会自动生成并打印到日志
LINKSHORT_ADMIN_KEY=

# 短链公共前缀（例如 https://s.example.com）；留空时使用请求 Host
LINKSHORT_BASE_URL=

# 备份目录，默认./backups（backup.sh 与 /api/backup/health 共用）
LINKSHORT_BACKUP_DIR=./backups
# 备份最大允许天数（健康端点过期判定），默认 7；0=不检查过期
LINKSHORT_BACKUP_MAX_AGE_DAYS=7
# 备份失败告警 webhook：backup.sh 失败时 POST JSON 通知，留空=不通知
LINKSHORT_ALERT_WEBHOOK_URL=

# 可信反向代理名单（v1.13.1+）：逗号分隔的 IP 或 CIDR；X-Forwarded-For/X-Real-IP 只在直连接入方
# 落在名单内时才被信任。留空=不信任任何代理的头（默认，最安全）；跑在 Nginx/Caddy 之后时
# 把代理本机 IP 配进来（如 127.0.0.1 或 10.0.0.0/8）。非法项会导致启动失败。
LINKSHORT_TRUSTED_PROXIES=

# CSV 导出额外限流（v1.15+）：两处导出端点共用的慢速令牌桶，每分钟限额，默认 10；<=0=关闭导出额外限流（全局限流仍在）
LINKSHORT_EXPORT_RATE_LIMIT_PER_MINUTE=10

