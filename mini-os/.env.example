PORT=8090
DATABASE_PATH=data/mini-os.db
STATIC_DIR=static
# 单文件上传大小上限（字节），默认 52428800（50MB）
UPLOAD_MAX_BYTES=52428800
# 优雅关闭排空阶段超时（秒），默认 30；只约束收到 SIGTERM/Ctrl+C 后的排空，不影响正常服务
SHUTDOWN_TIMEOUT_SECS=30
# 登录限流：每秒补充 token 数（默认 1）；非法值启动即报错退出
MINIOS_LOGIN_RPS=1
# 登录限流：桶容量/突发上限（默认 5）；非法值启动即报错退出
MINIOS_LOGIN_BURST=5

