    "bg": "#000000",
    "bg_glow": "#121212",
    "panel": "#000000",
    "panel_2": "#141414",
    "text": "#FFFFFF",
    "text_dim": "#9A9A9A",
    "accent": "#FFFFFF",
    "accent_hi": "#FFFFFF",
    "accent_2": "#8A8A8A",
    "hair": "#333333",
    "stroke": "#4A4A4A",
    "highlight_bg": "#FFFFFF",
    "highlight_text": "#000000"
  },
