  "type": {
    "keyword": {
      "font": "sans",
      "weight": 600,
      "size": 92,
      "tracking": 2
    },
    "chapter_num": {
      "font": "mono",
      "weight": 500,
      "size": 26
    },
    "chapter_zh": {
      "font": "sans",
      "weight": 500,
      "size": 32
    },
    "chapter_en": {
      "font": "latin",
      "weight": 600,
      "size": 24,
      "tracking_em": 0.18
    },
    "label": {
      "font": "mono",
      "weight": 400,
      "size": 24
    }
  },
  "motion": {
    "stagger": 0.035,
    "focus_dur": 0.42,
    "focus_blur": 10,
    "focus_dy": 18,
    "out_dur": 0.26,
    "ease_in": "expoOut",
    "ease_out": "cubicIn"
  },
  "post": {
    "bloom": [
      1.0,
      0.85
    ],
    "bloom_sigma": [
      4.0,
      8.0
    ],
    "glow_alpha": "additive",
    "vignette": {
      "opaque": 0.3,
      "overlay": 0.0
    },
    "vignette_radius": [
      0.3,
      0.78
    ],
    "grain": {
      "opaque": 1.0,
      "overlay": 0.0
    },
    "shutter": 0.5,
    "mb_max": 12
  }
