PORT=8090
DATABASE_PATH=data/mini-os.db
STATIC_DIR=static
# 单文件上传大小上限（字节），默认 52428800（50MB）
UPLOAD_MAX_BYTES=52428800
# 优雅关闭排空阶段超时（秒），默认 30；只约束收到 SIGTERM/Ctrl+C 后的排空，不影响正常服务
SHUTDOWN_TIMEOUT_SECS=30
# 登录限流：每秒补充 token 数（默认 1）；非法值启动即报错退出
MINIOS_LOGIN_RPS=1
# 登录限流：桶容量/突发上限（默认 5）；非法值启动即报错退出
MINIOS_LOGIN_BURST=5
# 两步验证独立限流：每秒补充 token 数（默认 1）；IP 单维度，与登录桶解耦；非法值启动即报错退出
MINIOS_2FA_RPS=1
# 两步验证独立限流：桶容量/突发上限（默认 5）；非法值启动即报错退出
MINIOS_2FA_BURST=5
# 两步验证主密钥：64 个十六进制字符（32 字节），用于 AES-256-GCM 加密用户 TOTP 密钥；未配置时 2FA 接口报 500，普通登录不受影响
MINIOS_TOTP_MASTER_KEY=
# 已用备用码保留期（天），默认 90；超期已用码在备用码登录成功后清扫；合法范围 1 到 3650，非法值启动即报错退出
MINIOS_BACKUP_CODE_RETENTION_DAYS=90

# 数据目录覆盖：留空表示不覆盖，回退链为 DATABASE_PATH 的父目录，再回退 data
MINIOS_DATA_DIR=
# 会话滑动续期开关：开启后会话随活动自动续期，默认 true；非法值启动即报错退出
MINIOS_SESSION_SLIDING=true
# 分享读限流每秒补充令牌数，默认 5；非法值启动即报错退出
MINIOS_SHARE_RPS=5
# 分享读限流桶容量，默认 30；非法值启动即报错退出
MINIOS_SHARE_BURST=30
# 分享读限流总开关，默认 true；非法值启动即报错退出
MINIOS_SHARE_RATE_LIMIT_ENABLED=true
# 终端单会话连续输出上限（字节），默认 1048576（1MiB）；必须是正整数，非法值或 0 启动即报错退出
MINIOS_TERM_OUTPUT_LIMIT=1048576
