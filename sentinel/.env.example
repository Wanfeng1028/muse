# ============================================================
# 哨兵 Sentinel 环境变量示例
# 用法：cp .env.example .env 后按需修改
# 所有变量都可以留空，留空时走代码里的默认值
# ============================================================

# SQLite 数据库文件路径（相对路径基于工作目录）
# 默认：data/sentinel.db
SENTINEL_DB=data/sentinel.db

# 监听地址。容器里跑必须用 0.0.0.0，本机调试可以改 127.0.0.1
# 默认：0.0.0.0
SENTINEL_HOST=0.0.0.0

# 监听端口
# 默认：8200
SENTINEL_PORT=8200

# 告警 webhook 地址（Slack / 钉钉 / 企业微信 / 自建接收端都行）
# 留空则不发告警，只写日志
SENTINEL_WEBHOOK_URL=

# 【必填】API Token，用于保护 /api/* 写接口和读取接口
# 生成方式（32 字节十六进制，够安全）：
#   openssl rand -hex 32
# 生成后填到下面，客户端请求带 Authorization: Bearer <token>
SENTINEL_API_TOKEN=

# 日志级别：debug / info / warn / error
# 默认：info
SENTINEL_LOG_LEVEL=info

# 自动备份输出目录
# 默认：backups
SENTINEL_BACKUP_DIR=backups

# 保留多少份备份，超过的旧备份会被删掉
# 默认：7
SENTINEL_BACKUP_KEEP=7

# 自动备份间隔（小时）
# 默认：24（每天一次）
SENTINEL_BACKUP_INTERVAL_H=24

# 单次检查调度的最大并发数，防止把目标站打爆
# 默认：8
SENTINEL_CHECK_CONCURRENCY=8

# 单次检查失败后的最大重试次数（指数退避）
# 默认：3
SENTINEL_CHECK_RETRY_MAX=3

# 检查调度 tick 间隔（秒），越小越精细但越费 CPU
# 默认：10
SENTINEL_TICK_SEC=10

# 对外基地址：订阅确认/退订邮件里的链接前缀
# 留空则邮件里用相对路径（如 /api/status/xxx/confirm?token=...）
# 示例：https://status.example.com
SENTINEL_PUBLIC_URL=
