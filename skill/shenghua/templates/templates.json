      "blocks": ["slam", "strike", "highlight-box", "stacked-slams", "counter", "terminal", "stamp", "vhs", "crt", "diagram", "chart", "logo-wall", "path", "lower-third", "clip", "broll", "quote", "outro", "host", "bubble", "pill", "lane"]
    },
