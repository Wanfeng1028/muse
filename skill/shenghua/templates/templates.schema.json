{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shenghua Theme Manifest",
  "type": "object",
  "required": ["templates"],
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "name", "scheme", "mood", "best_for", "music", "blocks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "file": { "type": "string" },
          "name": { "type": "string" },
          "default": { "type": "boolean" },
          "scheme": { "enum": ["dark", "light"], "description": "the canvas the theme is designed for; a kit on the other canvas gets its bgAlt or a derived one" },
          "mood": { "type": "string" },
          "best_for": { "type": "array", "items": { "type": "string" } },
          "fonts": { "type": "string" },
          "motion": {
            "type": "object",
            "properties": {
              "enter": { "type": ["string", "null"] },
              "shake": { "type": "number" },
              "flash": { "type": "number" },
              "pulse": { "type": "number" }
            }
          },
          "music": {
            "type": "object",
            "required": ["bpm", "root", "progression", "layers"],
            "properties": {
              "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
              "root": { "type": "integer", "minimum": 0, "maximum": 127 },
              "progression": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer" } }
              },
              "layers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["pad", "bass", "pluck", "pulse"] }
              }
            }
          },
          "blocks": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
