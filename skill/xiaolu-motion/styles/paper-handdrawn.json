{
  "name": "paper-handdrawn",
  "version": "0.1",
  "extends": "base",
  "description": "纸本手绘：牛皮纸卡片底、近黑墨色、图章红强调（呼应演示里的红色印章）、暖黄辅色。取自 library/ 的 faceless 演示（纸本手绘、不露脸风格），是按演示视频的观感重新配的令牌起点，颜色未逐像素取自源素材，用前按自己的素材微调。关键词角色默认换成手写体（kai）；辉光调到接近关闭（哑光纸面不反光），颗粒调高一点模拟纸纹。",
  "colors": {
    "bg": "#FAF6ED",
    "bg_glow": "#FFFDF6",
    "panel": "#D9C9A8",
    "panel_2": "#FFFCF4",
    "text": "#2B2620",
    "text_dim": "#7A6F5C",
    "accent": "#C0392B",
    "accent_hi": "#E8B84B",
    "accent_2": "#8C7A55",
    "hair": "#CBB98F",
    "stroke": "#A79C87",
    "highlight_bg": "#C0392B",
    "highlight_text": "#FFFCF4"
  },
  "type": {
    "keyword": { "font": "kai", "weight": 500, "size": 92, "tracking": 1 }
  },
  "post": {
    "bloom": [0.05, 0.05],
    "grain": { "opaque": 1.4, "overlay": 0.2 },
    "vignette": { "opaque": 0.1, "overlay": 0.0 }
  }
}
