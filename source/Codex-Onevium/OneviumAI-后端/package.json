{
  "name": "onevium",
  "version": "1.3.0",
  "private": true,
  "author": {
    "name": "Onevium",
    "email": "support@onevium.com"
  },
  "homepage": "https://onevium.com",
  "description": "Your personal AI superapp — powered by Claude Code",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "unset __NEXT_PRIVATE_STANDALONE_CONFIG && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "tsx scripts/check-i18n.mjs",
    "test:i18n-check": "tsx --test scripts/check-i18n.test.mjs",
    "check:uiux": "node scripts/check-uiux-governance.mjs",
    "check:uiux:changed": "node scripts/check-uiux-governance.mjs --changed",
    "check:providers": "node scripts/check-provider-registry.mjs",
    "check:official-links": "node scripts/check-official-links.mjs && node --test scripts/check-official-links.test.mjs && tsx --test src/__tests__/unit/official-links.test.ts",
    "test:official-links-browser": "node scripts/official-links.browser.mjs",
    "check:github-release-identity": "node scripts/check-github-release-identity.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "check:widget-prompt": "npx tsx src/__tests__/unit/widget-catalog.test.ts && npx tsx src/__tests__/unit/tool-token-estimate.test.ts && npx tsx scripts/generate-tool-context-estimates.ts --check",
    "probe:browser": "node scripts/browser-runtime-probe.mjs",
    "check:quality": "npm run lint && npm run check:providers && npm run check:official-links && npm run check:uiux && npx tsc --noEmit && npm run check:widget-prompt && npm run check:mermaid-render && npm run check:i18n && npm run test:i18n-check",
    "electron:dev": "concurrently -k \"ONEVIUM_INTERNAL_PORT=3338 next dev --webpack -p 3338\" \"wait-on http://localhost:3338 && DEV_PORT=3338 electron .\"",
    "electron:build": "node scripts/release-pipeline.mjs build",
    "electron:pack": "node scripts/release-pipeline.mjs pack all",
    "electron:pack:mac": "node scripts/release-pipeline.mjs pack mac",
    "electron:pack:mac:arm64": "node scripts/release-pipeline.mjs pack mac-arm64",
    "electron:pack:mac:x64": "node scripts/release-pipeline.mjs pack mac-x64",
    "electron:pack:win": "node scripts/release-pipeline.mjs pack win",
    "electron:pack:linux": "node scripts/release-pipeline.mjs pack linux",
    "electron:pack:linux:x64": "node scripts/release-pipeline.mjs pack linux-x64",
    "electron:pack:linux:arm64": "node scripts/release-pipeline.mjs pack linux-arm64",
    "check:mermaid-render": "env -u NODE_ENV npx tsx src/__tests__/unit/mermaid-block-state.test.ts",
    "check:release": "node scripts/release-pipeline.mjs check"
  },
