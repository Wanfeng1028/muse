{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "paths": {
      "openclaw/plugin-sdk": ["./node_modules/@types/node"],
      "openclaw/plugin-sdk/plugin-entry": ["./node_modules/@types/node"]
    }
  },
  "include": ["*.ts", "tools/*.ts"]
}
