# ===== 舞监台 StageCue 服务端配置示例 =====
# 复制为 .env 后按需修改；切勿把真实 .env 提交到仓库

# 服务端监听端口
STAGECUE_PORT=8080

# 服务端监听地址（0.0.0.0 表示允许局域网内其它控台接入）
STAGECUE_HOST=0.0.0.0

# 数据目录：存放演出状态快照、日志等（相对路径基于进程工作目录）
STAGECUE_DATA_DIR=./data

# WebSocket 心跳间隔（毫秒）
STAGECUE_WS_PING_INTERVAL_MS=15000

# 日志级别：DEBUG / INFO / WARN / ERROR
STAGECUE_LOG_LEVEL=INFO

# 允许跨域来源（逗号分隔，* 表示允许全部；生产环境请收敛）
STAGECUE_CORS_ALLOWED_ORIGINS=*

# ---- 启动校验说明（v0.2.0 起）----
# 以下任一项非法，服务端启动时直接报错退出（exit 1），不会带病运行：
# - STAGECUE_PORT 不是 1~65535 的整数
# - STAGECUE_LOG_LEVEL 不是 DEBUG / INFO / WARN / ERROR 之一
# - STAGECUE_WS_PING_INTERVAL_MS 不是 ≥1000 的整数
# - STAGECUE_DATA_DIR 不存在且无法创建，或不可写
