<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 控制台 appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 滚动文件 appender：按时间 + 大小切分 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${stagecue.log.dir:-./data/logs}/stagecue.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${stagecue.log.dir:-./data/logs}/stagecue.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>50MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>14</maxHistory>
            <totalSizeCap>512MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 业务 logger：显式挂 FILE + STDOUT，禁止向 root 冒泡 -->
    <logger name="dev.stagecue" level="${STAGECUE_LOG_LEVEL:-INFO}" additivity="false">
        <appender-ref ref="FILE"/>
        <appender-ref ref="STDOUT"/>
    </logger>

    <!-- 第三方库降噪 -->
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="io.ktor" level="WARN"/>

    <!-- root：level 由 STAGECUE_LOG_LEVEL 环境变量控制，缺省 INFO -->
    <root level="${STAGECUE_LOG_LEVEL:-INFO}">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
