<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoxLoom.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#1C1A17" />
      <Setter Property="Foreground" Value="#E8E2D5" />
      <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, sans-serif" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E8E2D5" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#E8E2D5" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#A39E93" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBlock.accent">
      <Setter Property="Foreground" Value="#E8833A" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#2E2A24" />
      <Setter Property="Foreground" Value="#E8E2D5" />
      <Setter Property="BorderBrush" Value="#3A342C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A342C" />
      <Setter Property="BorderBrush" Value="#E8833A" />
      <Setter Property="Foreground" Value="#E8E2D5" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#26221D" />
      <Setter Property="BorderBrush" Value="#E8833A" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#221F1A" />
      <Setter Property="Foreground" Value="#6B665C" />
      <Setter Property="BorderBrush" Value="#2E2A24" />
    </Style>

    <Style Selector="Button.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="#E8833A" />
      <Setter Property="Foreground" Value="#1C1A17" />
      <Setter Property="BorderBrush" Value="#E8833A" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0924A" />
      <Setter Property="BorderBrush" Value="#F0924A" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#C96D2C" />
      <Setter Property="BorderBrush" Value="#C96D2C" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="#26221D" />
      <Setter Property="BorderBrush" Value="#3A342C" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E8E2D5" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="0,0,0,1" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2E2A24" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A342C" />
      <Setter Property="Foreground" Value="#E8E2D5" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="#26221D" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#26221D" />
      <Setter Property="BorderBrush" Value="#3A342C" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.toolbar">
      <Setter Property="Background" Value="#26221D" />
      <Setter Property="BorderBrush" Value="#3A342C" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="Border.statusbar">
      <Setter Property="Background" Value="#221F1A" />
      <Setter Property="BorderBrush" Value="#3A342C" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
  </Application.Styles>
</Application>
